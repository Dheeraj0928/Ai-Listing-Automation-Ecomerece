# ============================================
# AI Multi-Marketplace Seller Listing Platform
# Environment Variables
# ============================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://listingadmin:listingpass123@localhost:5432/listing_automation
DATABASE_URL_SYNC=postgresql://listingadmin:listingpass123@localhost:5432/listing_automation

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT Authentication ----
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- AI Providers (Phase 2) ----
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=...
# AI_PROVIDER=mock

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Email (Phase 2) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@yourdomain.com
